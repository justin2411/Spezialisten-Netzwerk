{
  "buildCommand": "npx @11ty/eleventy",
  "outputDirectory": "_site",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/finanz-und-ruhestandsplanung{/}?",
      "destination": "/ruhestandsplanung",
      "permanent": true
    },
    {
      "source": "/immobilien-finanzierung{/}?",
      "destination": "/finanzierung",
      "permanent": true
    },
    {
      "source": "/gewerbliche-finanzierung{/}?",
      "destination": "/finanzierung",
      "permanent": true
    },
    {
      "source": "/kranken-und-pflegeversicherung{/}?",
