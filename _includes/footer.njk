<!-- ════════ FOOTER (zentral) ════════ -->
<footer class="ft" role="contentinfo">
  <div class="sn-mosaic" style="right:-40px;bottom:40px;width:260px;height:260px;opacity:.55" aria-hidden="true">
    <span class="sn-tile t3" style="width:70px;height:70px;left:40px;top:60px"></span>
    <span class="sn-tile t2" style="width:70px;height:70px;left:120px;top:0"></span>
    <span class="sn-tile t1" style="width:70px;height:70px;left:120px;top:110px;animation-delay:-3s"></span>
    <span class="sn-tile t5" style="width:70px;height:70px;left:200px;top:55px;animation-delay:-5s"></span>
  </div>
  <div class="sn-wrap">
    <div class="ftt">
      <div>
        <div class="ftl"><img src="/assets/img/logo.png" alt="Das Spezialisten Netzwerk" width="210" height="44"></div>
        <p class="ftd">Individuelle Wohlstandsplanung durch 13+ Fachspezialisten. Ungebunden, vernetzt, Strategie vor Produkt.</p>
        <a href="/kontakt" class="sn-btn sn-btn--sm">Jetzt Kontakt aufnehmen</a>
      </div>
      <div>
        <h5>Themen</h5>
        {%- for t in site.themen | batch(4) | first %}
        <a href="{{ t.url }}">{{ t.title }}</a>
        {%- endfor %}
      </div>
      <div>
        <h5>Weitere Themen</h5>
        {%- for t in site.themen | batch(4) | last %}
        <a href="{{ t.url }}">{{ t.title }}</a>
        {%- endfor %}
      </div>
      <div>
        <h5>Netzwerk</h5>
        <a href="/optiplan">OptiPlan</a>
        <a href="/#team">Unsere Spezialisten</a>
        <a href="/kontakt">Kontakt</a>
        <a href="https://spezialisten-netzwerk.com/impressum/">Impressum</a>
        <a href="https://spezialisten-netzwerk.com/datenschutzerklaerung/">Datenschutzerklärung</a>
      </div>
    </div>
    <div class="ftb">
      <span>© 2026 Spezialisten-Netzwerk – Alle Rechte vorbehalten</span>
      <div class="ftbl">
        <a href="https://spezialisten-netzwerk.com/impressum/">Impressum</a>
        <a href="https://spezialisten-netzwerk.com/datenschutzerklaerung/">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>
