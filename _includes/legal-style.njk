{#- Gemeinsames Layout für Impressum und Datenschutz -#}
<style>
.lg-hero{padding:calc(var(--sp-sec)*.75) 0}
.lg-hero .sn-h1{margin-bottom:0;hyphens:manual;-webkit-hyphens:manual}
@media(max-width:620px){.lg-long{font-size:clamp(1.6rem,8.6vw,2rem)}}
.lg-doc{max-width:860px;margin:0 auto;background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);box-shadow:var(--sh);padding:clamp(1.5rem,5vw,3.5rem)}
.lg-doc h2{font-size:clamp(1.25rem,2.2vw,1.5rem);font-weight:800;color:var(--ink);line-height:1.3;margin:2.4rem 0 .9rem;padding-top:1.6rem;border-top:1px solid var(--line)}
.lg-doc h2:first-child{margin-top:0;padding-top:0;border-top:0}
.lg-doc h3{font-size:1.08rem;font-weight:800;color:var(--gd);margin:1.6rem 0 .5rem}
.lg-doc p,.lg-doc li{font-size:1rem;line-height:1.75;color:var(--text);overflow-wrap:anywhere}
.lg-doc p+p{margin-top:.8rem}
.lg-doc ul{margin:.8rem 0 .8rem 1.2rem}
.lg-doc li+li{margin-top:.4rem}
.lg-doc a{color:var(--gd);font-weight:700}
.lg-doc strong{color:var(--ink)}
.lg-card{background:var(--g50);border:1px solid var(--g200);border-radius:var(--r);padding:var(--sp-card);margin:1rem 0}
.lg-card p{margin:0}
.lg-todo{background:#fff4cc;border:1px dashed var(--amber);border-radius:6px;padding:0 .35rem;font-weight:700;color:#7a5a00}
</style>
