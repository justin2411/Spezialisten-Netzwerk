<!-- ════════ NAV (zentral – eine Nav für alle Seiten, Themen aus _data/site.js) ════════ -->
<nav class="nav" id="nav" aria-label="Hauptnavigation">
  <div class="ni">
    <a href="/" class="nl" aria-label="Zur Startseite">
      <img src="/assets/img/logo.png" alt="Das Spezialisten Netzwerk" width="190" height="40">
    </a>
    <div class="nm">
      <a href="/#netzwerk">Das Netzwerk</a>
      <div class="nav-dd">
        <button class="dd-trigger" type="button" aria-haspopup="true" aria-expanded="false">
          Themen
          <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="dd-menu">
          <div class="dd-inner">
            <div class="dd-grid">
              {%- for t in site.themen %}
              <a class="dd-item" href="{{ t.url }}">
                <span class="sn-ico sn-ico--sm"><svg viewBox="0 0 24 24">{{ t.icon | safe }}</svg></span>
                <span><b>{{ t.title }}</b><small>{{ t.teaser }}</small></span>
              </a>
              {%- endfor %}
            </div>
            <div class="dd-side">
              <span class="sn-ico sn-ico--sm"><svg viewBox="0 0 24 24">{{ site.icons.optiplan | safe }}</svg></span>
              <b>OptiPlan: Drei Dimensionen. Ein Plan.</b>
              <p>Liquidität, Vermögen und Steuern in einem kohärenten System.</p>
              <a href="/optiplan" class="sn-btn sn-btn--sm">OptiPlan ansehen</a>
            </div>
          </div>
        </div>
      </div>
      <a href="/optiplan">OptiPlan</a>
      <a href="/#vorgehen">Vorgehen</a>
      <a href="/#team">Team</a>
      <a href="/#faq">FAQ</a>
    </div>
    <a href="/kontakt" class="nc">Kostenloses Erstgespräch <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    <button class="hb" id="hbtn" type="button" aria-label="Menü öffnen" aria-controls="mmenu" aria-expanded="false"><span></span><span></span><span></span></button>
  </div>
</nav>

<!-- Mobile-Menü -->
<div class="mm" id="mmenu" aria-label="Mobile Navigation">
  <a href="/#netzwerk">Das Netzwerk</a>
  <a href="/optiplan">OptiPlan</a>
  <a href="/#vorgehen">Vorgehen</a>
  <a href="/#team">Team</a>
  <a href="/#faq">FAQ</a>
  <div class="mm-label">Themen</div>
  <div class="mm-themen">
    {%- for t in site.themen %}
    <a href="{{ t.url }}"><span class="sn-ico sn-ico--sm"><svg viewBox="0 0 24 24">{{ t.icon | safe }}</svg></span>{{ t.title }}</a>
    {%- endfor %}
  </div>
  <a href="/kontakt" class="nc">Kostenloses Erstgespräch</a>
</div>

<script>
(function () {
  var nav = document.getElementById('nav');
  if (nav) {
    var onS = function () { nav.classList.toggle('scrolled', window.scrollY > 10); };
    window.addEventListener('scroll', onS, { passive: true }); onS();
  }
  var hb = document.getElementById('hbtn');
  var mm = document.getElementById('mmenu');
  function closeMenu() {
    mm.classList.remove('open'); hb.classList.remove('open');
    hb.setAttribute('aria-expanded', 'false'); document.body.style.overflow = '';
  }
  if (hb && mm) {
    hb.addEventListener('click', function () {
      var open = mm.classList.toggle('open');
      hb.classList.toggle('open', open);
      hb.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.style.overflow = open ? 'hidden' : '';
    });
    mm.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', closeMenu); });
  }
  // Themen-Mega-Menü: Hover mit Schließverzögerung + Klick/Tastatur
  var dd = document.querySelector('.nav-dd');
  if (dd) {
    var trg = dd.querySelector('.dd-trigger'), t;
    var set = function (o) { dd.classList.toggle('open', o); trg.setAttribute('aria-expanded', o ? 'true' : 'false'); };
    dd.addEventListener('mouseenter', function () { clearTimeout(t); set(true); });
    dd.addEventListener('mouseleave', function () { t = setTimeout(function () { set(false); }, 160); });
    trg.addEventListener('click', function () { set(!dd.classList.contains('open')); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
  }
  // Aktiven Menüpunkt markieren
  var p = location.pathname.replace(/\.html$/, '');
  document.querySelectorAll('.nm>a').forEach(function (a) { if (a.getAttribute('href') === p) a.classList.add('active'); });
})();
</script>
