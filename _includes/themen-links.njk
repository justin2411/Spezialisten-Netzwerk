{#- Querverweise auf die anderen Themen. Optional vorher setzen: currentTheme (key aus _data/site.js) -#}
<section class="sn-sec sn-sec--tint2" style="padding-bottom:clamp(2rem,4vw,3rem)">
  <div class="sn-wrap">
    <div class="sn-head sn-tc">
      <div class="sn-eyebrow rv">Alles aus einer Hand</div>
      <h2 class="sn-h2 rv">Weitere Themen im <span class="sn-hl">Netzwerk</span></h2>
      <p class="sn-lead rv">Ein zentraler Ansprechpartner koordiniert 13+ Spezialisten. Kein Abstimmungsaufwand, keine Lücken zwischen Beratern.</p>
    </div>
    <div class="sn-topics">
      {%- for t in site.themen | otherThemes(currentTheme, 4) %}
      <a href="{{ t.url }}" class="sn-topic rv d{{ loop.index }}">
        <div class="sn-topic-top">
          <span class="sn-ico sn-ico--sm"><svg viewBox="0 0 24 24">{{ t.icon | safe }}</svg></span>
          <span class="sn-avatars">{% for p in t.people %}<img src="{{ site.team[p].img }}" alt="{{ site.team[p].name }}" style="object-position:{{ site.team[p].pos or 'top' }}">{% endfor %}</span>
        </div>
        <h4>{{ t.title }}</h4>
        <p>{{ t.teaser }}</p>
        <span class="sn-topic-go">Mehr erfahren <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>
