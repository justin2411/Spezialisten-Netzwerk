{#- Dekorative Mosaik-Kacheln (Logo-Motiv) hinter der rechten Hero-Spalte -#}
<div class="sn-mosaic" style="right:-30px;top:-40px;width:340px;height:340px" aria-hidden="true">
  <span class="sn-tile t2" style="width:90px;height:90px;left:150px;top:10px"></span>
  <span class="sn-tile t1" style="width:70px;height:70px;left:250px;top:90px;animation-delay:-2s"></span>
  <span class="sn-tile t3" style="width:110px;height:110px;left:120px;top:130px;animation-delay:-4s"></span>
  <span class="sn-tile t4" style="width:40px;height:40px;left:60px;top:60px;animation-delay:-6s"></span>
</div>
<div class="sn-mosaic" style="left:-40px;bottom:-30px;width:200px;height:200px" aria-hidden="true">
  <span class="sn-tile t5" style="width:80px;height:80px;left:20px;top:60px;animation-delay:-3s"></span>
  <span class="sn-tile t2" style="width:44px;height:44px;left:110px;top:120px;animation-delay:-5s"></span>
</div>
